# Vorlage fuer die lokale .env — hier stehen nur Platzhalter, keine echten Werte.
#
# Achtung: Der Supabase-Client in src/integrations/supabase/client.ts liest diese
# Werte NICHT — er ist von Lovable generiert und traegt URL und anon-Key fest ein.
# Wirksam sind hier nur VITE_DEV_EMAIL und der Fallback im Chatbot.

# Schaltet Entwickleransichten frei (Activity-Log, Dev-Ansichten)
VITE_DEV_EMAIL=name@example.com

# Nur vom Chatbot als Fallback gelesen; oeffentliche Werte des Supabase-Projekts
VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key>
VITE_SUPABASE_PROJECT_ID=<projekt-ref>
